<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projetoAndroid.Pages.adicionarPeriodo"
             Title="adicionarPeriodo">
    
    <VerticalStackLayout Padding="30"
                         Spacing="20">
        <Label 
            x:Name="lblNome"
            Text="NOME DO PERÍODO"/>
        <Entry
            x:Name="etrNome"
            Placeholder="Escreva aqui"/>

        <Grid RowDefinitions="*, *" ColumnDefinitions="*, *"
              RowSpacing="1"
              ColumnSpacing="20">
            <Label
                x:Name="lblId"
                Text="ID"
                Grid.Row="0"
                Grid.Column="0"/>
            <Entry
                x:Name="etrId"
                IsEnabled="False"
                BackgroundColor="Grey"
                Grid.Row="1"
                Grid.Column="0"/>

            <Label 
                x:Name="lblSigla"
                Text="SIGLA"
                Grid.Row="0"
                Grid.Column="1"/>
            <Entry
                x:Name="etrSigla"
                Placeholder="Escreva aqui"
                Grid.Row="1"
                Grid.Column="1"/>
        </Grid>

        <Button
            x:Name="btnConfirmar"
            Text="CONFIRMAR"
            Clicked="btnInserir_Clicked"/>

        <Button
            x:Name="btnCancelar"
            Text="CANCELAR"
            Clicked="BtnCancelar_Clicked"/>
    </VerticalStackLayout>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projetoAndroid.Pages.editarPeriodo"
             Title="editarPeriodo">

    <VerticalStackLayout Padding="30"
                     Spacing="20">
        <Label 
            x:Name="lblEditaNomePeriodo"
            Text="NOME DO PERÍODO"/>
        <Entry
            x:Name="etrEditaNomePeriodo"
            Placeholder="Escreva aqui"/>

        <Grid RowDefinitions="*,*" ColumnDefinitions="*,*"
              RowSpacing="10"
              ColumnSpacing="20">
            <Label
                x:Name="lblEditaIdPeriodo"
                Text="ID"
                Grid.Row="0"
                Grid.Column="0"/>
            <Entry
                x:Name="etrEditaIdPeriodo"
                IsEnabled="False"
                BackgroundColor="Grey"
                Grid.Row="1"
                Grid.Column="0"/>

            <Label 
                x:Name="lblEditaSiglaPeriodo"
                Text="SIGLA"
                Grid.Row="0"
                Grid.Column="1"/>
            <Entry
                x:Name="etrEditaSiglaPeriodo"
                Placeholder="Escreva aqui"
                Grid.Row="1"
                Grid.Column="1"/>
        </Grid>

        <Grid ColumnDefinitions="*,*"
              Padding="20"
              ColumnSpacing="20">
            <Button
                Grid.Column="0"
                x:Name="btnEditaConfirmaPeriodo"
                Text="CONFIRMAR"
                Clicked="ConfirmaEdicao_Clicked"/>

            <Button
                Grid.Column="1"
                x:Name="btnEditaDescartaPeriodo"
                Text="DESCARTAR"
                Clicked="BtnVoltar_Clicked"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
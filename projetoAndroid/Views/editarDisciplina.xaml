<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projetoAndroid.Views.editarDisciplina"
             Title="editarDisciplina">

    <VerticalStackLayout Padding="30"
                     Spacing="20">
        <Label 
    x:Name="lblEditaNomeDisciplina"
    Text="NOME DA DISCIPLINA"/>
        <Entry
    x:Name="etrEditaNomeDisciplina"
    Text="{Binding Nome}"/>

        <Grid RowDefinitions="*, *" ColumnDefinitions="*, *"
              RowSpacing="1"
              ColumnSpacing="20">
            <Label
                x:Name="lblEditaIdDisciplina"
                Text="ID"
                Grid.Row="0"
                Grid.Column="0"/>
            <Entry
                x:Name="etrEditaIdDisciplina"
                IsEnabled="False"
                Text="{Binding Id}"
                BackgroundColor="Grey"
                Grid.Row="1"
                Grid.Column="0"/>

            <Label 
                x:Name="lblEditaSiglaDisciplina"
                Text="SIGLA"
                Grid.Row="0"
                Grid.Column="1"/>
            <Entry
                x:Name="etrEditaSiglaDisciplina"
                Text="{Binding Sigla}"
                Grid.Row="1"
                Grid.Column="1"/>
        </Grid>

        <Label 
            x:Name="lblEditaObsDisciplina"
            Text="OBSERVAÇÕES"/>
        <Editor
            x:Name="edtEitaDisciplinas"
            Text="{Binding Obs}"/>

        <Button
            x:Name="btnConfirmaDisciplina"
            Text="CONFIRMAR"
            Clicked="BtnAlterar_Clicked"/>

        <Button
            x:Name="btnDescartaDisciplina"
            Text="DESCARTAR"
            Clicked="BtnCancelar_Clicked"/>
    </VerticalStackLayout>
</ContentPage>